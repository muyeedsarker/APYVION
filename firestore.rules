rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Generic app data: owner-scoped by uid.
    match /appData/{docId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }


    // APYVION Secure Vault metadata: each item belongs only to its owner.
    match /vaultItems/{itemId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Default deny. Add explicit collection rules for production features.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
